.encoding = "windows-1252"
config.version = "8"
virtualHW.version = "12"
displayName = "BSD45 - install from ISO"
guestOS = "other"
memsize = "64"
numvcpus = "1"

# ---- live install ISO on ide1:0 (secondary master) ----
ide1:0.present = "TRUE"
ide1:0.deviceType = "cdrom-image"
ide1:0.fileName = "..\out\BSD45-ELF-x86.iso"
ide1:0.startConnected = "TRUE"

# ---- blank 64 MiB virtual disk on ide0:0 (primary master) ----
# install.c writes FFS/stage2/kernel/MBR here; guest sees it as wd0 (ATA).
# IMPORTANT: use a BLANK disk here. After install, boot BSD45-diskboot.vmx
# which points at the pre-installed BSD45-installed.vmdk instead.
ide0:0.present = "TRUE"
ide0:0.deviceType = "disk"
ide0:0.fileName = "BSD45-blank.vmdk"
ide0:0.startConnected = "TRUE"

usb.present = "FALSE"
keyboard.vusb.enable = "FALSE"
mouse.vusb.enable = "FALSE"
keyboard.allowBothIRQs = "FALSE"

# Boot the CD first so the live ISO monitor comes up and `install` can run.
bios.bootOrder = "cdrom"

# Optional serial log for watching the install console.
serial0.present = "TRUE"
serial0.fileType = "file"
serial0.fileName = "bsd45-install-serial.log"

extendedConfigFile = "BSD45-install.vmxf"
virtualHW.productCompatibility = "hosted"
ide0:1.present = "FALSE"
ide1:1.present = "FALSE"
floppy0.present = "FALSE"
ethernet0.present = "FALSE"
sound.present = "FALSE"
vmxstats.filename = "BSD45-install.scoreboard"
numa.autosize.cookie = "10001"
numa.autosize.vcpu.maxPerVirtualNode = "1"
uuid.bios = "56 4d 94 4e 7e ec 9a b3-01 48 a0 9e 61 58 24 b8"
uuid.location = "56 4d 94 4e 7e ec 9a b3-01 48 a0 9e 61 58 24 b8"
ide0:0.redo = ""
svga.vramSize = "134217728"
vmotion.checkpointFBSize = "134217728"
vmotion.checkpointSVGAPrimarySize = "134217728"
monitor.phys_bits_used = "42"
cleanShutdown = "TRUE"
softPowerOff = "FALSE"

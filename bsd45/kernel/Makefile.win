# Windows/MSYS2-adapted copy of the original kernel/Makefile.
# Everything is identical except:
#   (1) extra include paths: build/ (assym.s) and kernel/net (net/netisr.h)
#   (2) a rule to compile arch/i386/x86.asm (the original only has a .s rule)
#   (3) embed.o added to OBJS (usermode.c needs the embedded-image symbols)
#   (4) link step uses the Windows PE -> ELF32 route (ld -m i386pe + objcopy)
#   (5) fs/jlfs/config.mk is included explicitly (fs/config.mk only knows ffs)
# The repository's original Makefile is left untouched.
MAKEFILE_DIR_project_mk := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
.DEFAULT_GOAL = all

ARCH ?= i386
DEBUG ?= n
CROSS ?=
CC   := $(CROSS)gcc
LD   := $(CROSS)ld
AR   := $(CROSS)ar
OBJCOPY := $(CROSS)objcopy

BUILD_DIR ?= $(abspath $(MAKEFILE_DIR_project_mk)/../build)
OBJ_DIR   ?= $(BUILD_DIR)/obj
$(shell test -e $(OBJ_DIR) || mkdir -p $(OBJ_DIR))

CPPFLAGS += -nostdinc \
    -I$(BUILD_DIR) \
    -I$(BUILD_DIR)/inc \
    -I$(BUILD_DIR)/gen \
    -I$(MAKEFILE_DIR_project_mk) \
    -I$(MAKEFILE_DIR_project_mk)/include \
    -I$(MAKEFILE_DIR_project_mk)/include/sys \
    -I$(MAKEFILE_DIR_project_mk)/include/machine \
    -I$(MAKEFILE_DIR_project_mk)/include/i386 \
    -I$(MAKEFILE_DIR_project_mk)/arch \
    -I$(MAKEFILE_DIR_project_mk)/arch/$(ARCH) \
    -I$(MAKEFILE_DIR_project_mk)/net

CFLAGS += -m32 -std=gnu89 -O2 -ffreestanding -fleading-underscore \
    -fno-pie -fno-pic -fcommon -fno-builtin -fno-stack-protector \
    -fno-asynchronous-unwind-tables -fno-unwind-tables \
    -fno-tree-loop-distribute-patterns -march=i386 \
    -mno-sse -mno-sse2 -mno-mmx -mno-avx -mno-ms-bitfields \
    -mpreferred-stack-boundary=2 -ffunction-sections -fdata-sections \
    -DKERNEL -DARCH_$(ARCH)

ifeq (${DEBUG}, y)
CFLAGS += -O0 -g
endif

# assembler flags (same as the original Makefile, line 70)
ASMFLAGS := -m32 -c -x assembler-with-cpp -nostdinc -DKERNEL -DLOCORE

include $(MAKEFILE_DIR_project_mk)/lib/config.mk
OBJS += $(lib_OBJS)
include $(MAKEFILE_DIR_project_mk)/sys/config.mk
OBJS += $(sys_OBJS)
include $(MAKEFILE_DIR_project_mk)/thread/config.mk
OBJS += $(thread_OBJS)
include $(MAKEFILE_DIR_project_mk)/fs/config.mk
OBJS += $(fs_OBJS)
# jlfs (writable UFS1) is a separate directory and is NOT reachable from
# fs/config.mk; the stock kernel/Makefile pulls it in explicitly as well.
include $(MAKEFILE_DIR_project_mk)/fs/jlfs/config.mk
OBJS += $(jlfs_OBJS)
include $(MAKEFILE_DIR_project_mk)/driver/config.mk
OBJS += $(driver_OBJS)
include $(MAKEFILE_DIR_project_mk)/vm/config.mk
OBJS += $(vm_OBJS)
include $(MAKEFILE_DIR_project_mk)/arch/config.mk
OBJS += $(arch_OBJS)

OBJS := $(shell echo "${OBJS}" | tr ' ' '\n' | awk '!a[$$0]++' | tr '\n' ' ')

# (3) embedded images object (generated by prep step / build_kernel scripts)
EMBED_OBJ := $(BUILD_DIR)/embed.o
OBJS += $(EMBED_OBJ)

KERNEL_ELF := $(BUILD_DIR)/bsd45.elf
KERNEL_PE  := $(BUILD_DIR)/kernel.pe

all: $(KERNEL_ELF)

# (2) x86.asm has no rule in the stock config.mk (it only handles .s).
X86_OBJ := $(filter %/x86.o,$(OBJS))
$(X86_OBJ): $(MAKEFILE_DIR_project_mk)/arch/i386/x86.asm
	@echo ---------------------[build $<]----------------------------------
	$(CC) -m32 -c -x assembler-with-cpp -nostdinc $(CPPFLAGS) -DKERNEL -DLOCORE $< -o $@

$(EMBED_OBJ): $(BUILD_DIR)/embed.c
	@echo ---------------------[build $<]----------------------------------
	$(CC) $(CFLAGS) -c $(CPPFLAGS) $< -o $@

# (4) Windows link path: COFF objects -> PE32 -> ELF32.
# The pe_bss_fix step is what keeps the image small: mingw32-gcc puts every
# static zero-initialised object into a ".data$xxx" section that carries its
# bytes, so big arrays (heap, pipes, procs ...) would otherwise be stored in
# the kernel file exactly like initialised data.  The helper rewrites those
# all-zero sections as bss, which is what an ELF toolchain does on its own.
$(KERNEL_ELF): $(OBJS)
	@echo "---------------------[link PE $@]----------------------------------"
	-python $(MAKEFILE_DIR_project_mk)/../tools/pe_bss_fix.py --recurse $(OBJ_DIR)
	$(LD) -m i386pe --image-base 0xFE000000 -Ttext 0xFE001000 \
	    --subsystem console -e start --gc-sections --disable-reloc-section \
	    --file-alignment 0x1000 --section-alignment 0x1000 \
	    --defsym _end=0xFE080000 --defsym _edata=0xFE040000 \
	    --defsym _etext=0xFE040000 \
	    -o $(KERNEL_PE) $(OBJS)
	$(OBJCOPY) -O elf32-i386 -R .idata -R .reloc $(KERNEL_PE) $@

.PHONY : clean
clean::
	rm -f $(OBJS) $(KERNEL_ELF) $(KERNEL_PE)
